{
    "xray_ssh_host": {
        "description": "Xray SSH 主机",
        "type": "string",
        "hint": "Xray 所在服务器的 SSH 主机名，默认使用 SSH 配置中的 dm。留空则在 AstrBot 本机执行 Xray 命令。",
        "default": "dm"
    },
    "xray_ssh_user": {
        "description": "Xray SSH 用户名",
        "type": "string",
        "hint": "留空时使用 SSH 配置或当前系统用户。",
        "default": ""
    },
    "xray_ssh_port": {
        "description": "Xray SSH 端口",
        "type": "int",
        "hint": "默认 22。",
        "default": 22
    },
    "xray_api_address": {
        "description": "Xray API 地址",
        "type": "string",
        "hint": "从 SSH 主机访问的 API 地址。",
        "default": "127.0.0.1:10085"
    },
    "xray_command": {
        "description": "Xray 命令",
        "type": "string",
        "hint": "SSH 主机上 Xray 可执行文件的路径或命令名。",
        "default": "xray"
    },
    "net_reset_day": {
        "description": "每月流量重置日",
        "type": "int",
        "hint": "每月该日 00:00 清零本地账本和 Xray 计数器，支持 1 至 28。",
        "default": 6
    }
}
